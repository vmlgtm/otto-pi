{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otto-pi",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "worker_loaders": [{ "binding": "LOADER" }],

  "previews": {
    "worker_loaders": [{ "binding": "LOADER" }],
    "ai": { "binding": "AI", "remote": true },
    "durable_objects": {
      "bindings": [
        {
          "name": "PiAgent",
          "class_name": "PiAgent"
        }
      ]
    }
  },

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "test": {
      "name": "otto-pi-test"
    }
  }
}
